{
  "name": "@modusoperandi/licit-changecase",
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "type": "module",
  "subversion": "1",
  "description": "changecase plugin built with ProseMirror",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/MO-Movia/licit-plugin-contrib-change-case"
  },
  "scripts": {
    "clean": "rm -rf dist/ coverage/ bin/ && rm -f modusoperandi-licit-changecase-*.*.*.tgz",
    "lint:ts": "eslint src --ext .ts,.tsx --fix",
    "lint": "npm run lint:ts",
    "ci:build": "tsc --build && copyfiles --up 1 \"src/**/*.css\" dist  && copyfiles package.json LICENSE README.md dist",
    "test:unit": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test": "jest --coverage",
    "debug": "node --debug-brk --inspect ./node_modules/.bin/jest -i",
    "ci:bom": "npx cyclonedx-bom -o dist/bom.xml",
    "verify": "npm run lint -- --fix && npm run ci:build && npm run test:coverage && echo 'All Tests Passed!'"
  },
  "peerDependencies": {
    "prosemirror-state": "^1.0.0",
    "prosemirror-transform": "^1.0.0",
    "prosemirror-view": "^1.0.0",
    "@modusoperandi/licit-doc-attrs-step": "^1.0.0",
    "@modusoperandi/licit-ui-commands": "^1.0.0"
  },
  "devDependencies": {
    "prosemirror-state": "^1.0.0",
    "prosemirror-transform": "^1.0.0",
    "prosemirror-view": "^1.0.0",
    "@modusoperandi/licit-doc-attrs-step": "^1.0.0",
    "@modusoperandi/licit-ui-commands": "^1.0.0",
    "@modusoperandi/eslint-config": "^2.1.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.40.0",
    "copyfiles": "^2.4.1",
    "enzyme": "^3.11.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.1.2",
    "jest-json": "^2.0.0",
    "jest-junit": "^16.0.0",
    "jest-prosemirror": "^3.0.1",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "react-test-renderer": "^18.3.1",
    "resize-observer-polyfill": "^1.5.1",
    "terser-webpack-plugin": "^5.3.14",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "overrides": {},
  "importSort": {
    ".js": {
      "parser": "babylon",
      "style": "module-grouping"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "!(*test|*.setup).ts": [
    "eslint --fix"
  ],
  "*.json": [
    "prettier --write"
  ]
}